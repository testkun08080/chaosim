{# HyperFrames standalone composition base.
   Contract: one root <div data-composition-id="main" data-duration="N"> directly
   in <body>; exactly one paused GSAP timeline registered at
   window.__timelines["main"]. Render duration comes from data-duration. #}
<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width={{ width }}, height={{ height }}">
<title>{{ title | default('composition') }}</title>
<script src="{{ gsap_src | default('https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js') }}"></script>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body {
    margin: 0; width: {{ width }}px; height: {{ height }}px; overflow: hidden;
    background: {{ 'transparent' if transparent else bg_color }};
    color: {{ text_color }};
    font-family: 'Noto Sans JP', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', sans-serif;
  }
  #scene {
    position: relative;
    width: {{ width }}px; height: {{ height }}px;
    overflow: hidden;
  }
  .clip { position: absolute; inset: 0; }
  {% block style %}{% endblock %}
</style>
</head>
<body>
  <div id="scene"
       data-composition-id="main"
       data-start="0"
       data-width="{{ width }}"
       data-height="{{ height }}"
       data-duration="{{ '%.3f' | format(duration | default(3.0) | float) }}">
    <section class="clip" data-start="0"
             data-duration="{{ '%.3f' | format(duration | default(3.0) | float) }}"
             data-track-index="1">
      {% block body %}{% endblock %}
    </section>
  </div>
  <script>
    window.__timelines = window.__timelines || {};
    var tl = gsap.timeline({ paused: true });
    {% block timeline %}{% endblock %}
    window.__timelines["main"] = tl;
  </script>
</body>
</html>
