<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<style>
  html, body { margin: 0; width: {{ width | default(1280) }}px; height: {{ height | default(720) }}px;
    overflow: hidden; background: {{ bg_color }}; color: {{ text_color }};
    font-family: 'Noto Sans JP', 'Yu Gothic', sans-serif; }
  .stage { width: 100%; height: 100%; display: flex; flex-direction: column;
    justify-content: center; padding: 0 90px; box-sizing: border-box;
    background: radial-gradient(circle at 30% 30%, {{ accent }}22, {{ bg_color }} 70%); }
  .kicker { font-size: 48px; font-weight: 700; color: {{ accent }}; letter-spacing: 2px; }
  .headline { font-size: 120px; font-weight: 900; line-height: 1.05; margin: 24px 0 0; }
</style>
</head>
<body>
  <div class="stage"
       data-composition-id="thumbnail"
       data-width="{{ width | default(1280) }}" data-height="{{ height | default(720) }}"
       data-start="0" data-duration="0.1" data-track-index="0">
    <div class="kicker">{{ kicker | default('CHAOS SIM') }}</div>
    <div class="headline">{{ headline | default(title) }}</div>
  </div>
</body>
</html>
