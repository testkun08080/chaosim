<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<style>
  html, body { margin: 0; width: {{ width | default(1080) }}px; height: {{ height | default(1920) }}px;
    overflow: hidden; background: {{ bg_color }}; color: {{ text_color }};
    font-family: 'Noto Sans JP', 'Yu Gothic', sans-serif; }
  .stage { width: 100%; height: 100%; display: flex; flex-direction: column;
    justify-content: flex-end; padding: 0 70px 220px; box-sizing: border-box;
    background: linear-gradient(180deg, {{ bg_color }} 0%, {{ accent }}33 100%); }
  .headline { font-size: 130px; font-weight: 900; line-height: 1.04; margin: 0; }
  .sub { margin-top: 30px; font-size: 56px; color: {{ accent }}; font-weight: 700; }
</style>
</head>
<body>
  <div class="stage"
       data-composition-id="thumbnail"
       data-width="{{ width | default(1080) }}" data-height="{{ height | default(1920) }}"
       data-start="0" data-duration="0.1" data-track-index="0">
    <div class="headline">{{ headline | default(title) }}</div>
    <div class="sub">{{ hook }}</div>
  </div>
</body>
</html>
