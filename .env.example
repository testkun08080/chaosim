ANTHROPIC_API_KEY=sk-ant-...
BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender
YOUTUBE_CLIENT_SECRET_PATH=config/youtube_client_secret.json
OUTPUT_DIR=outputs
RENDER_DEVICE=CPU

# HyperFrames (HTML -> video material). Prefer the local install after `npm install`.
HYPERFRAMES_PATH=./node_modules/.bin/hyperframes
# ffmpeg used by HyperFrames internally. Override if static-ffmpeg v8 causes issues:
#   https://github.com/heygen-com/hyperframes/issues/XXX
# HYPERFRAMES_FFMPEG_PATH=/usr/bin/ffmpeg
# VOICEVOX engine (Japanese narration). Run e.g. via docker on port 50021.
VOICEVOX_URL=http://localhost:50021
# Optional: explicit font for ffmpeg drawtext captions (Japanese-capable).
# CHAOSIM_FONT=/System/Library/Fonts/Supplemental/Arial Unicode.ttf
# Force all external tools into ffmpeg stubs (testing without heavy deps).
# CHAOSIM_STUB=1
# Pin the Blender render engine. Unset = autodetect (EEVEE first, then Cycles).
# Headless CI has no GPU/GL context, so EEVEE there aborts or renders black
# frames — the GitHub Actions sim workflow sets this to CYCLES.
# CHAOSIM_RENDER_ENGINE=CYCLES
# Cap the rendered frame count (0/unset = uncapped). Used as a CI cost guard so
# a long concept cannot burn the whole job budget. Does not apply to staged
# scenes, which compute their own frame range.
# CHAOSIM_MAX_FRAMES=900
